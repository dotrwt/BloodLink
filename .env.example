# ============================================================
# BloodBridge AI - Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Database ---
# MySQL connection string (required)
DATABASE_URL=mysql+pymysql://username:password@localhost/bloodbridge

# --- JWT Auth ---
# Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_super_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App Settings ---
APP_NAME=Blood Link
APP_VERSION=1.0.0
DEBUG=True

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Notification (future integrations) ---
# FCM_SERVER_KEY=your_firebase_server_key
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE=+1234567890
